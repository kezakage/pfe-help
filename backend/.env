# Django
# In production: generate with `python -c "import secrets; print(secrets.token_hex(50))"`.
# Settings will refuse to start with DJANGO_DEBUG=0 unless this is overridden.
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
# In production: list explicit hostnames; the wildcard "*" is refused when DEBUG=0.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Production-only — origins that may POST CSRF-protected forms.
# Comma-separated, must include the scheme (https://patrimoine.example.com).
DJANGO_CSRF_TRUSTED_ORIGINS=

# Production-only — HSTS knobs (sane defaults: 1y / includeSubDomains / preload).
# Set DJANGO_HSTS_SECONDS=0 during the initial HTTPS rollout to avoid lock-in.
DJANGO_HSTS_SECONDS=31536000
DJANGO_HSTS_INCLUDE_SUBDOMAINS=1
DJANGO_HSTS_PRELOAD=1
DJANGO_SECURE_SSL_REDIRECT=1

# Database (PostgreSQL + PostGIS)
POSTGRES_DB=patrimoinehub
POSTGRES_USER=patrimoine
POSTGRES_PASSWORD=patrimoine
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# JWT
JWT_ACCESS_LIFETIME_MIN=60
JWT_REFRESH_LIFETIME_DAYS=14

# MinIO / S3
USE_S3=1
AWS_ACCESS_KEY_ID=patrimoine
AWS_SECRET_ACCESS_KEY=patrimoine123
AWS_STORAGE_BUCKET_NAME=patrimoinehub-media
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ADDRESSING_STYLE=path

# Elasticsearch
ELASTICSEARCH_URL=http://elasticsearch:9200

# Chatbot RAG
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-mpnet-base-v2

# Media upload limits (bytes)
MAX_IMAGE_SIZE=52428800
MAX_VIDEO_SIZE=524288000

# Grafana admin credentials (default admin/admin — change in production)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# OAuth2 / SSO — set these to enable "Continue with Google/GitHub".
# When the client_id is empty, the corresponding social-login endpoint
# returns 503 (provider_not_configured) so the rest of the API still works.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Where the provider redirects the browser after consent (frontend route).
SOCIAL_REDIRECT_FRONTEND=http://localhost:5173
